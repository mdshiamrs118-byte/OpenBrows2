<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_quad">
    <alpha
        android:duration="180"
        android:fromAlpha="0"
        android:toAlpha="1" />
    <scale
        android:duration="180"
        android:fromXScale="0.9"
        android:fromYScale="0.9"
        android:pivotX="85%"
        android:pivotY="85%"
        android:toXScale="1"
        android:toYScale="1" />
</set>
