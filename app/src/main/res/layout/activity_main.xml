<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:id="@+id/mainColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/toolbarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/padding_small">

            <com.openbrows.app.ui.components.GlassmorphicToolbar
                android:id="@+id/urlToolbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/toolbar_height"
                android:elevation="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/padding_small">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/toolbar_button_size"
                    android:layout_height="@dimen/toolbar_button_size"
                    android:background="@drawable/ripple_effect"
                    android:contentDescription="@string/cd_back"
                    android:padding="8dp"
                    android:src="@drawable/ic_back" />

                <ImageButton
                    android:id="@+id/btnForward"
                    android:layout_width="@dimen/toolbar_button_size"
                    android:layout_height="@dimen/toolbar_button_size"
                    android:background="@drawable/ripple_effect"
                    android:contentDescription="@string/cd_forward"
                    android:padding="8dp"
                    android:src="@drawable/ic_forward" />

                <EditText
                    android:id="@+id/etUrlBar"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/toolbar_button_size"
                    android:layout_weight="1"
                    android:autofillHints="url"
                    android:background="@android:color/transparent"
                    android:hint="@string/hint_search_url"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:selectAllOnFocus="true"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnReload"
                    android:layout_width="@dimen/toolbar_button_size"
                    android:layout_height="@dimen/toolbar_button_size"
                    android:background="@drawable/ripple_effect"
                    android:contentDescription="@string/cd_reload"
                    android:padding="8dp"
                    android:src="@drawable/ic_reload" />

                <ImageButton
                    android:id="@+id/btnTabs"
                    android:layout_width="@dimen/toolbar_button_size"
                    android:layout_height="@dimen/toolbar_button_size"
                    android:background="@drawable/ripple_effect"
                    android:contentDescription="@string/cd_tabs"
                    android:padding="8dp"
                    android:src="@drawable/ic_tabs" />

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="@dimen/toolbar_button_size"
                    android:layout_height="@dimen/toolbar_button_size"
                    android:background="@drawable/ripple_effect"
                    android:contentDescription="@string/cd_menu"
                    android:padding="8dp"
                    android:src="@drawable/ic_menu" />

            </com.openbrows.app.ui.components.GlassmorphicToolbar>

        </FrameLayout>

        <LinearLayout
            android:id="@+id/middleRow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tabListLeft"
                android:layout_width="@dimen/side_tab_panel_width"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/padding_small"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/webArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/webViewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_gravity="top"
                    android:max="100"
                    android:visibility="gone" />

            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tabListRight"
                android:layout_width="@dimen/side_tab_panel_width"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/padding_small"
                android:visibility="gone" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabStripBottom"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tab_bar_size"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/padding_small"
            android:visibility="gone" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnShowToolbar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:background="@drawable/bg_glassmorphic"
        android:contentDescription="@string/cd_show_toolbar"
        android:elevation="12dp"
        android:src="@drawable/ic_toolbar_show"
        android:visibility="gone" />

    <com.openbrows.app.ui.components.SlidingTabPanel
        android:id="@+id/tabSlidingPanel"
        android:layout_width="@dimen/sliding_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:elevation="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/padding_small">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panelTabList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />

            <Button
                android:id="@+id/btnPanelAddTab"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:drawableStart="@drawable/ic_add_tab"
                android:drawablePadding="12dp"
                android:gravity="start|center_vertical"
                android:paddingHorizontal="16dp"
                android:text="@string/menu_new_tab" />

        </LinearLayout>

    </com.openbrows.app.ui.components.SlidingTabPanel>

</FrameLayout>
